# Public URL of this API (used to build stream_url fields)
PUBLIC_BASE_URL=http://localhost:8000

# CORS: comma separated origins. "*" allows any origin but disables credentials.
CORS_ORIGINS=http://localhost:5173

# Use the OS certificate store (needed behind TLS-inspecting corporate proxies)
USE_SYSTEM_TRUSTSTORE=false

# YouTube Music client
YTMUSIC_LANGUAGE=en
YTMUSIC_LOCATION=
YTMUSIC_MAX_CONCURRENCY=8

# Cache: memory (per worker) or redis (shared; install with `uv sync --extra redis`)
CACHE_BACKEND=memory
CACHE_MAX_ITEMS=4096
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SEARCH=600
CACHE_TTL_SUGGESTIONS=600
CACHE_TTL_ALBUM=21600
CACHE_TTL_ARTIST=21600
CACHE_TTL_WATCH=600
CACHE_TTL_LYRICS=86400

# Browser cache (Cache-Control max-age) for metadata endpoints
HTTP_CACHE_MAX_AGE=300

# Audio streaming (yt-dlp format selector: AAC itag 140 first, then Opus itag 251)
STREAM_FORMAT=140/251/bestaudio[ext=m4a]/bestaudio
STREAM_EXPIRY_MARGIN_SECONDS=300
STREAM_FALLBACK_TTL_SECONDS=1800
STREAM_RETRY_DELAY_SECONDS=0.5
STREAM_CHUNK_SIZE=65536
STREAM_UPSTREAM_WINDOW_BYTES=10485760
STREAM_PREFETCH_MAX_IDS=50
YTDLP_MAX_CONCURRENCY=4
YTDLP_JS_RUNTIME=deno

# Outgoing HTTP client used by the audio proxy
HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=30
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE=20
HTTP_KEEPALIVE_EXPIRY=30
HTTP2_ENABLED=true

# Rate limiting per client IP (token bucket, per worker)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=60
TRUST_PROXY_HEADERS=false

# Log requests whose headers take longer than this
SLOW_REQUEST_MS=1000
